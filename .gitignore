# ===================================================
# PYTHON BASICS
# ===================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.env
.venv
venv/
ENV/
env/
.ipynb_checkpoints/

# ===================================================
# SYSTEM / OS FILES
# ===================================================
.DS_Store
Thumbs.db
desktop.ini

# ===================================================
# IDEs / EDITORS
# ===================================================
.vscode/
.idea/
*.swp
*.swo

# ===================================================
# DATASETS & LARGE FILES
# Compatible with structure: data/raw, data/processed, data/external
# ===================================================
data/raw/
data/processed/
data/external/
dataset/
*.csv
*.tsv
*.xlsx
*.xls
*.json
*.zip
*.rar

# ===================================================
# MODEL FILES & OUTPUTS
# Compatible with: models/, analytics outputs
# ===================================================
models/
trained_models/
bert_embeddings/
tfidf_embeddings/
confusion_matrices/
results_visuals/
*.joblib
*.pkl
*.pt
*.pth
*.ckpt
*.h5
*.npy
*.npz

# ===================================================
# TEMP / CACHE FILES
# ===================================================
*.log
*.tmp
*.bak
tmp/
temp/
cache/
__MACOSX/

# ===================================================
# NOTEBOOKS & CHECKPOINTS
# Keep .ipynb files, exclude checkpoints only
# ===================================================
*.ipynb_checkpoints/
*.out
*.nbconvert.ipynb

# ===================================================
# CONFIG & SECRETS
# ===================================================
*.env
config.json
credentials.json
token.json

# ===================================================
# OPTIONAL
# ===================================================
outputs/
test_results/
screenshots/
